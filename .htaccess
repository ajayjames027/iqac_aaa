# IQAC AAA 2026-2027 - Apache / cPanel Configuration
# St. Joseph's College (Autonomous), Tiruchirappalli

# Disable Directory Browsing
Options -Indexes

# Set Default Charset
AddDefaultCharset UTF-8

# Protect Sensitive Configuration & Schema Files
<FilesMatch "^(schema\.sql|\.git.*|\.env|package\.json|.*\.py)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Allow API cross-origin if needed
<IfModule mod_headers.c>
    Header set Access-Control-Allow-Origin "*"
    Header set Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With"
    Header set Access-Control-Allow-Methods "GET, POST, OPTIONS"
</IfModule>

# Compress Static Assets for Fast Presentation Loading
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>
